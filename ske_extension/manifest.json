{
  "manifest_version": 3,
  "name": "Sakura Encryptor 跨域小助手",
  "version": "1.0.0",
  "description": "为指定网盘的跨域响应补上 Access-Control-Allow-Origin，让网页端可以读取密文并解密。",
  "minimum_chrome_version": "128",
  "key": "",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "activeTab",
    "storage"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sakura Encryptor 跨域小助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
