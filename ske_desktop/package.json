{
  "name": "ske-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sakura Encryptor desktop client",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "verify:shell": "electron scripts/verify-shell.mjs",
    "verify:downloads": "electron scripts/verify-downloads.mjs",
    "verify:stage": "electron scripts/verify-stage.mjs",
    "verify:music": "electron scripts/verify-music.mjs",
    "verify:range": "node scripts/verify-range.mjs",
    "verify:tags": "node scripts/verify-tags.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "verify:names": "node scripts/verify-names.mjs",
    "verify:totp": "node scripts/verify-totp.mjs",
    "verify:cloud": "node scripts/verify-cloud.mjs",
    "verify:writer": "node scripts/verify-writer.mjs",
    "verify:jobs": "node scripts/verify-jobs.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.sakura.encryptor",
    "productName": "Sakura Encryptor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "fileAssociations": [
      {
        "ext": "ske",
        "name": "Sakura Encryptor 容器",
        "description": "Sakura Encryptor 加密媒体容器",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "SakuraEncryptor-Desktop-Windows-x64.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "artifactName": "SakuraEncryptor-Desktop-Linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "artifactName": "SakuraEncryptor-Desktop-MacOS-ARM64.${ext}"
    }
  }
}
