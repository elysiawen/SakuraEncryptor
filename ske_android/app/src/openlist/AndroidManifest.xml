<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only this flavor runs the embedded server in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <!-- Same lifetime as the process, so the notification is what keeps it
             from being frozen while serving files. -->
        <service
            android:name=".embedded.LocalOpenListService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
