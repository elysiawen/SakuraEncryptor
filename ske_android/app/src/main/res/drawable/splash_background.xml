<?xml version="1.0" encoding="utf-8"?>
<!--
  Cold-start window background.

  The system paints this before the process has even finished starting, so it is
  the very first thing the user sees. Showing the brand mark here (instead of a
  bare colour, or worse, white) removes the "did it hang?" gap and makes the
  hand-off to the Compose brand plate seamless.

  The colour is a day/night resource, so it follows the system theme.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/sakura_window_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground"
            android:width="128dp"
            android:height="128dp" />
    </item>
</layer-list>
